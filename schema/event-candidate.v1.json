{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AobaIwaki123/lumi-spec/main/schema/event-candidate.v1.json",
  "title": "Lumi Event Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source_ref", "title", "local_date"],
  "properties": {
    "schema_version": {"const": "lumi.event.candidate.v1"},
    "id": {"type": "string", "minLength": 1},
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "record_id"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "collection_id": {"type": "string"}
      }
    },
    "title": {"type": "string", "minLength": 1},
    "local_date": {"type": "string", "format": "date"},
    "starts_at": {"type": "string", "format": "date-time"},
    "ends_at": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string"},
    "venue": {"type": "string"},
    "performers": {"type": "array", "items": {"type": "string"}},
    "performer_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "organizer_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
