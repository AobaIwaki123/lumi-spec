{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AobaIwaki123/lumi-spec/main/schema/entity.v1.json",
  "title": "Lumi Entity v1",
  "description": "アイドル、グループ、会場、主催者などの共通プロフィール",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "name", "source_refs"],
  "properties": {
    "schema_version": {"const": "lumi.entity.v1"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["idol", "group", "venue", "organizer"]},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": {"enum": ["icon", "logo", "image"]},
          "url": {"type": "string", "format": "uri"},
          "alt": {"type": "string"},
          "width": {"type": "integer", "minimum": 0},
          "height": {"type": "integer", "minimum": 0},
          "mime_type": {"type": "string"}
        }
      }
    },
    "social_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "url"],
        "properties": {
          "platform": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "handle": {"type": "string"},
          "label": {"type": "string"}
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "record_id"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "record_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "collection_id": {"type": "string"}
        }
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
